# Local MongoDB used by the backend started from Gradle.
MONGODB_IMAGE=mongodb/mongodb-community-server:8.0-ubi9-slim
MONGODB_PORT=27017
MONGODB_URI=mongodb://localhost:27017/health_tg

# Required for live Telegram authentication. Keep real values only in .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# BE3-05 demo seed/reset (leave empty/false outside a dedicated demo database)
HEALTH_TG_DEMO_ENVIRONMENT=false
HEALTH_TG_DEMO_DATABASE=
SEED_REGULAR_TELEGRAM_ID=
SEED_IRREGULAR_TELEGRAM_ID=
SEED_INCOMPLETE_TELEGRAM_ID=
