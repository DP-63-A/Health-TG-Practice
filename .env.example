# Copy to .env. Never commit real values.
MONGODB_IMAGE=mongodb/mongodb-community-server:8.0-ubi9-slim
MONGODB_DATABASE=health_tg

# Required by API and bot. Replace placeholders in the private .env file.
TELEGRAM_BOT_TOKEN=replace-with-test-bot-token
TELEGRAM_ALLOWED_USER_IDS=100000001
MINI_APP_URL=https://replace-with-training-host.example

# Optional private image directory override. It must be the same absolute path
# for API and bot outside Compose. Compose uses its private shared named volume.
# FILE_STORAGE_ROOT=C:/health-tg-data/files

# Training environment settings.
APP_ENVIRONMENT=training
DEFAULT_TIMEZONE=Europe/Warsaw
FRONTEND_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:8088

# Host-side API/bot development uses this URI with compose.dev.yaml.
MONGODB_URI=mongodb://localhost:27017/health_tg
MONGODB_PORT=27017

# BE3-05 synthetic dataset. Use MONGODB_DATABASE=health_tg_demo with -Compose.
# Account values are existing internal user UUIDs, not Telegram IDs.
# For the protected host-side demo command only:
# MONGODB_URI=mongodb://localhost:27017/health_tg_demo
HEALTH_TG_DEMO=false
BE3_05_REGULAR_USER_ID=
BE3_05_IRREGULAR_USER_ID=
BE3_05_INCOMPLETE_USER_ID=
