# Local MongoDB used by the backend started from Gradle.
MONGODB_IMAGE=mongodb/mongodb-community-server:8.0-ubi9-slim
MONGODB_PORT=27017
MONGODB_URI=mongodb://localhost:27017/health_tg

# Shared private image directory used by both API and bot.
FILE_STORAGE_ROOT=./data/files

# Required for live Telegram authentication. Keep real values only in .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# BE3-05 local synthetic dataset. Account values are existing internal user UUIDs,
# not Telegram IDs. Set HEALTH_TG_DEMO=true only in a dedicated local demo setup.
HEALTH_TG_DEMO=false
BE3_05_REGULAR_USER_ID=
BE3_05_IRREGULAR_USER_ID=
BE3_05_INCOMPLETE_USER_ID=

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
