{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_class",
    "metrics",
    "ignored_labels"
  ],
  "properties": {
    "ignored_labels": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 100,
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "value",
          "unit",
          "local_date",
          "local_time",
          "qualifier",
          "field_origins"
        ],
        "properties": {
          "qualifier": {
            "enum": [
              "instant",
              "resting",
              null
            ]
          },
          "local_time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
          },
          "value": {
            "description": "Raw visible number. Fractional steps are retained as evidence and require application clarification; never round them.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "code": {
            "enum": [
              "steps",
              "sleep_duration_min",
              "heart_rate"
            ]
          },
          "field_origins": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "value",
              "unit",
              "local_date",
              "local_time",
              "qualifier"
            ],
            "properties": {
              "local_time": {
                "enum": [
                  "extracted",
                  null
                ]
              },
              "qualifier": {
                "enum": [
                  "extracted",
                  null
                ]
              },
              "unit": {
                "enum": [
                  "extracted",
                  null
                ]
              },
              "code": {
                "enum": [
                  "extracted",
                  null
                ]
              },
              "local_date": {
                "enum": [
                  "extracted",
                  null
                ]
              },
              "value": {
                "enum": [
                  "extracted",
                  null
                ]
              },
              "minutes_component": {
                "enum": [
                  "extracted",
                  null
                ]
              }
            }
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80,
            "minLength": 1
          },
          "local_date": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10
          },
          "minutes_component": {
            "maximum": 59,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "image_class": {
      "enum": [
        "health_screenshot",
        "watch_photo",
        "unknown"
      ]
    }
  }
}
