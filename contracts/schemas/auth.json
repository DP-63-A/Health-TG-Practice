{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tg.local/schemas/auth.json",
  "title": "AuthSchemas",
  "$defs": {
    "TelegramAuthRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["init_data"],
      "properties": {
        "init_data": {
          "type": "string",
          "minLength": 1,
          "description": "Raw Telegram Mini App initData string; server verifies signature and freshness (<= 15 minutes)."
        }
      }
    },
    "TelegramAuthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_token", "token_type", "expires_in", "user"],
      "properties": {
        "session_token": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque session token; store in frontend memory only; session TTL 60 minutes."
        },
        "token_type": {
          "type": "string",
          "const": "Bearer"
        },
        "expires_in": {
          "type": "integer",
          "const": 3600,
          "description": "Seconds until session expiry (60 minutes per TZ)."
        },
        "user": { "$ref": "user.json" }
      }
    },
    "EntryPatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_revision"],
      "properties": {
        "expected_revision": { "$ref": "common.json#/$defs/Revision" },
        "occurred_at": { "$ref": "common.json#/$defs/DateTimeUtc" },
        "payload": {
          "type": "object",
          "description": "Partial payload merge; shape must match entry type."
        },
        "field_origins": {
          "type": "object",
          "additionalProperties": { "$ref": "common.json#/$defs/FieldOrigin" }
        }
      }
    },
    "ConfirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_id", "expected_revision"],
      "properties": {
        "submission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": { "$ref": "common.json#/$defs/Revision" }
      }
    },
    "EntryListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "entry.json" }
        },
        "next_cursor": {
          "type": ["string", "null"],
          "description": "Opaque cursor; null when no more pages."
        }
      }
    },
    "HealthzResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "degraded"]
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["ok", "fail"]
          },
          "description": "No personal data."
        }
      }
    }
  }
}
